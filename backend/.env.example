# NuroTewedede backend environment variables
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# Port the backend listens on. Render/Railway set this automatically (default 5000 locally).
PORT=5000

# Supabase project URL (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=

# Supabase anon/publishable key (safe to expose client-side; RLS protects the data)
SUPABASE_ANON_KEY=

# Google Gemini API key used by the NuroAI assistant endpoint
GEMINI_API_KEY=

# Optional: comma-separated list of allowed frontend origins in production.
# Used for CORS with credentials. Example: https://nurotewdede.onrender.com
# Leave unset only for local development (the backend then allows any origin).
FRONTEND_ORIGIN=

# Set to 'production' on the hosted backend (enables HTTPS redirect + strict CORS).
NODE_ENV=production
